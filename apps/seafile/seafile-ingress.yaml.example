# Edge = Traefik (post-flip): HTTPS on websecure, TLS from the bridge cert
# (later: cert-manager). Copy to seafile-ingress.yaml (gitignored), set host +
# TLS secret. See .hermes/plans/2026-09-17_nginx-to-traefik-edge-flip.md.
#
# NO body-limit middleware here: Seafile uploads are unlimited (nginx used
# client_max_body_size 0). Buffering the body would break large file uploads.
# Collabora (WOPI editor) shares this host — see docs/decisions/online-office.md.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: seafile
  namespace: seafile
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
    traefik.ingress.kubernetes.io/router.middlewares: >-
      kube-system-security-headers@kubernetescrd,
      kube-system-rate-limit-general@kubernetescrd
    # cert-manager.io/cluster-issuer: letsencrypt-prod   # step 3, after cutover
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - seafile.example.com         # <-- deine Domain
      secretName: edge-bridge-cert  # bridge; later: cert-manager secret
  rules:
    - host: seafile.example.com       # <-- deine Domain
      http:
        paths:
          # Collabora Online (WOPI editor) — native top-level paths, no rewrite.
          - path: /browser
            pathType: Prefix
            backend:
              service:
                name: collabora
                port:
                  number: 9980
          - path: /cool
            pathType: Prefix
            backend:
              service:
                name: collabora
                port:
                  number: 9980
          - path: /hosting
            pathType: Prefix
            backend:
              service:
                name: collabora
                port:
                  number: 9980
          - path: /
            pathType: Prefix
            backend:
              service:
                name: seafile
                port:
                  number: 80
