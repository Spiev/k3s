# Edge = Traefik (post-flip): HTTPS on websecure, TLS from the bridge cert
# (later: cert-manager). Copy to freshrss-ingress.yaml (gitignored), set host +
# TLS secret. See .hermes/plans/2026-09-17_nginx-to-traefik-edge-flip.md.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: freshrss
  namespace: freshrss
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
    traefik.ingress.kubernetes.io/router.middlewares: >-
      kube-system-security-headers@kubernetescrd,
      kube-system-rate-limit-general@kubernetescrd,
      kube-system-body-limit-default@kubernetescrd
    # cert-manager (step 3, after cutover): uncomment to auto-issue into the
    # secret below instead of the bridge cert.
    # cert-manager.io/cluster-issuer: letsencrypt-prod
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - freshrss.example.com        # <-- deine Domain
      secretName: edge-bridge-cert  # bridge; later: cert-manager secret
  rules:
    - host: freshrss.example.com      # <-- deine Domain
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: freshrss
                port:
                  number: 80
