apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: teslamate-grafana
  namespace: teslamate
  labels:
    app: teslamate
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: web
    # LAN-only: blocks internet clients spoofing the Host header via the :80 forward
    traefik.ingress.kubernetes.io/router.middlewares: kube-system-lan-only@kubernetescrd
spec:
  ingressClassName: traefik
  rules:
    - host: teslamon.fritz.box    # muss mit GRAFANA_ROOT_URL im Secret übereinstimmen
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: teslamate-grafana
                port:
                  number: 3000
---
# HTTPS variant for browsers with automatic HTTPS upgrade (Brave/Chromium
# "Always use secure connections"): see infrastructure/monitoring/grafana-ingress.yaml.example.
# Separate Ingress because router.tls=true makes a router TLS-only on all its
# entrypoints. No secretName -> Traefik's self-signed default cert.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: teslamate-grafana-tls
  namespace: teslamate
  labels:
    app: teslamate
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
    # LAN-only: blocks internet clients spoofing the Host header via the :80 forward
    traefik.ingress.kubernetes.io/router.middlewares: kube-system-lan-only@kubernetescrd
spec:
  ingressClassName: traefik
  rules:
    - host: teslamon.fritz.box    # muss mit GRAFANA_ROOT_URL im Secret übereinstimmen
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: teslamate-grafana
                port:
                  number: 3000
