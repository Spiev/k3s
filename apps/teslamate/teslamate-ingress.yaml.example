apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: teslamate
  namespace: teslamate
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: web
    # LAN-only: blocks internet clients spoofing the Host header via the :80 forward
    traefik.ingress.kubernetes.io/router.middlewares: kube-system-lan-only@kubernetescrd
spec:
  ingressClassName: traefik
  rules:
    - host: teslamate.fritz.box
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: teslamate
                port:
                  number: 4000
