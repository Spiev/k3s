apiVersion: v1
kind: Secret
metadata:
  name: immich-monitoring-secrets
  namespace: immich
  labels:
    app: immich-db
type: Opaque
stringData:
  # Dedicated least-privilege monitoring role (pg_monitor) for postgres_exporter.
  # See docs/decisions/cluster-monitoring.md (Postgres metrics sub-decision).
  DATA_SOURCE_PASS: "<monitoring-user-passwort>"
