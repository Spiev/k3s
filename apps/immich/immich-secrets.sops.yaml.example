apiVersion: v1
kind: Secret
metadata:
  name: immich-secrets
  namespace: immich
  labels:
    app: immich
    managed-by: flux
stringData:
  # DB credentials — copy from ~/docker/immich/.env (MUST match the migrated data dir!)
  DB_PASSWORD: "<copy DB_PASSWORD from .env>"
  DB_USERNAME: "<copy DB_USERNAME from .env>"
  DB_DATABASE_NAME: "<copy DB_DATABASE_NAME from .env>"
  POSTGRES_PASSWORD: "<same as DB_PASSWORD>"
  POSTGRES_USER: "<same as DB_USERNAME>"
  POSTGRES_DB: "<same as DB_DATABASE_NAME>"
  POSTGRES_INITDB_ARGS: "--data-checksums"
  # Service wiring — point at the in-cluster services (NOT localhost like Docker)
  DB_HOSTNAME: "immich-postgres"
  REDIS_HOSTNAME: "immich-redis"
  IMMICH_MACHINE_LEARNING_URL: "http://immich-machine-learning:3003"
  TZ: "Europe/Berlin"
# After filling: rename to immich-secrets.sops.yaml and
#   sops --encrypt --in-place immich-secrets.sops.yaml
