{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["github-actions", "kubernetes", "custom.regex", "flux"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "customManagers": [
    {
      "description": "Track k3s releases",
      "customType": "regex",
      "fileMatch": ["^infrastructure/k3s-version\\.env$"],
      "matchStrings": ["K3S_VERSION=(?<currentValue>[^\\n]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "k3s-io/k3s",
      "versioningTemplate": "loose"
    },
    {
      "description": "Track prometheus-operator releases for the arm64-pin workaround (see docs/decisions/cluster-monitoring.md) — manual review only, a newer tag doesn't mean arm64 is fixed",
      "customType": "regex",
      "fileMatch": ["^infrastructure/monitoring/kube-prometheus-stack\\.yaml$"],
      "matchStrings": ["tag: v(?<currentValue>[0-9.]+) # renovate: prometheus-operator-arm64-pin"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "prometheus-operator/prometheus-operator",
      "versioningTemplate": "loose"
    }
  ],
  "kubernetes": {
    "fileMatch": ["apps/.+\\.yaml$", "infrastructure/.+\\.yaml$"]
  },
  "flux": {
    "fileMatch": ["infrastructure/.+\\.yaml$"]
  },
  "dependencyDashboard": false,
  "pinDigests": true,
  "packageRules": [
    {
      "description": "LinuxServer.io images use 1.x.y-lsNNN versioning — regex extracts build number for correct comparison",
      "matchPackagePrefixes": ["lscr.io/linuxserver/"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "description": "Gotenberg: stay on 8.x until Paperless-ngx supports v9",
      "matchPackageNames": ["docker.io/gotenberg/gotenberg"],
      "allowedVersions": "<9"
    },
    {
      "description": "Auto-merge minor, patch and digest updates",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Major updates require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "kube-prometheus-stack: manual review always, even patch — a chart release can silently bump a sub-component to a broken image (see the prometheus-operator arm64 incident in docs/decisions/cluster-monitoring.md)",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["kube-prometheus-stack"],
      "automerge": false
    },
    {
      "description": "prometheus-operator arm64-pin tracker: notify only, never auto-merge — arm64 availability must be checked manually before bumping",
      "matchPackageNames": ["prometheus-operator/prometheus-operator"],
      "automerge": false
    }
  ]
}
