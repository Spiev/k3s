# Restic backup configuration for the k3s Agent-Node (k3s-a1).
# Copy to .restic.env and set permissions:
#   cp .restic.env.example .restic.env && chmod 600 .restic.env

# ── Local HDD (primary Restic repository) ─────────────────────────────────────
# The external HDD/SSD that holds the Restic repo.
# Find the device with: lsblk -o NAME,FSTYPE,SIZE,MOUNTPOINT
export HDD_DEVICE="/dev/sdX1"
export HDD_MOUNT="/mnt/backup"
export RESTIC_REPO="/mnt/backup/restic-repo"
export RESTIC_PASSWORD="a_strong_random_passphrase_for_the_local_repo"

# ── S3 Offsite Backup (optional — Hetzner Object Storage) ─────────────────────
# Remove the four lines below to disable offsite backups entirely.
# Initialize the S3 repo once before first use:
#   source .restic.env
#   RESTIC_PASSWORD="$RESTIC_PASSWORD_S3" restic -r "$RESTIC_REPO_S3" init
export AWS_ACCESS_KEY_ID="YOUR_HETZNER_S3_ACCESS_KEY_ID"
export AWS_SECRET_ACCESS_KEY="YOUR_HETZNER_S3_SECRET_ACCESS_KEY"
# e.g. s3:https://nbg1.your-objectstorage.com/my-backup-bucket/restic-repo
export RESTIC_REPO_S3="s3:https://YOUR_REGION.your-objectstorage.com/YOUR_BUCKET/restic-repo"
export RESTIC_PASSWORD_S3="a_strong_random_passphrase_for_the_s3_repo"
