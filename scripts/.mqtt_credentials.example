# MQTT credentials — shared by all scripts that publish to Home Assistant.
# Copy to .mqtt_credentials and set permissions:
#   cp .mqtt_credentials.example .mqtt_credentials && chmod 600 .mqtt_credentials
export MQTT_HOST="your_mqtt_broker_ip_or_hostname"
export MQTT_PORT="1883"
export MQTT_USER="your_mqtt_username"
export MQTT_PASSWORD="your_mqtt_password"
