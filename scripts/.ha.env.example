# Home Assistant API credentials for ha_dashboard_sync.sh.
# Copy to .ha.env and set permissions:
#   cp .ha.env.example .ha.env && chmod 600 .ha.env
#
# HA_TOKEN: Long-lived access token
#           HA → Profil → Sicherheit → Langfristige Zugriffstoken
# HA_URL:   Base URL of your Home Assistant instance (no trailing slash)
HA_TOKEN="your_long_lived_access_token"
HA_URL="https://your_ha_host_or_ip:8123"
