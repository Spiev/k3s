# ClusterIssuer: Let's Encrypt production, HTTP-01 solved via Traefik.
# Copy to cluster-issuer.yaml (gitignored) and set the ACME account email.
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-prod
  labels:
    app: cert-manager
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: you@example.com          # <-- ACME account email
    privateKeySecretRef:
      name: letsencrypt-prod-account   # cert-manager stores its ACME account key here
    solvers:
      - http01:
          ingress:
            ingressClassName: traefik
