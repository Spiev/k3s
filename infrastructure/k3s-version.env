# Pinned k3s version — Renovate tracks this for update notifications.
#
# Merging a Renovate bump does NOT update the nodes. Run the update by hand,
# Server-Node first, then Agent-Node (same command on both, it detects the
# role). The procedure lives in one place only:
# docs/platform/k3s-install.md, section "9. Updating k3s".

K3S_VERSION=v1.37.1+k3s1
