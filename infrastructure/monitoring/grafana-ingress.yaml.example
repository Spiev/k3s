apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: grafana
  namespace: monitoring
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: web
    # LAN-only: diagnostic tool for the operator, not internet-facing.
    traefik.ingress.kubernetes.io/router.middlewares: kube-system-lan-only@kubernetescrd
spec:
  ingressClassName: traefik
  rules:
    - host: grafana.fritz.box    # <-- deine Domain eintragen
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: kube-prometheus-stack-grafana
                port:
                  number: 80
